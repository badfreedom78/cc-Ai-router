# ============================================================
# AI Router - Git 忽略清单
# 目的：确保真实密钥与运行产物永远不会被提交 / 打包出去。
# ============================================================

# 真实的模型配置（含 API Key 与接口地址）—— 绝不能提交
config.yaml

# 离线自测临时备份（tests/test_offline.py 会复制一份 config.yaml，
# 中断时可能残留，同样含真实密钥）
config.yaml.bak_test

# 强制路由覆盖文件（运行时生成）
router_override.json
router_override.json.tmp

# 界面语言等 GUI 设置（运行时生成）
gui_settings.json
gui_settings.json.tmp

# 运行日志与崩溃日志
logs/
*.log

# 首次安装时自动创建的虚拟环境
gui/.venv/
.venv/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 依赖安装标记
gui/.venv/.deps-ok
.deps-ok

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
